# Copy to .env and fill in for local development. Never commit the real .env.

LEASELENS_ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEASELENS_SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEASELENS_ENCRYPTION_KEY=

# "mock" (default, fully offline) or "anthropic"
LEASELENS_LLM_PROVIDER=mock
LEASELENS_ANTHROPIC_API_KEY=
LEASELENS_ANTHROPIC_MODEL=claude-sonnet-4-6

LEASELENS_DATABASE_URL=sqlite:///./leaselens.db
